rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validContactMessage(uid) {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'message',
          'portfolioUid',
          'read',
          'createdAt',
          'source'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.portfolioUid == uid
        && request.resource.data.read == false
        && request.resource.data.source == 'public_portfolio'
        && request.resource.data.createdAt == request.time;
    }

    match /portfolios/{uid} {
      allow read: if true;
      allow write: if owns(uid);
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /messages/{messageId} {
        allow create: if validContactMessage(uid);
        allow read, delete: if owns(uid);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true
          && request.resource.data.readAt == request.time;
      }

      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }
  }
}
